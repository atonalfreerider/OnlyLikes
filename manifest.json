{
  "manifest_version": 3,
  "name": "OnlyLikes",
  "version": "0.3",
  "description": "Filter out negative comments on social media platforms",
  "browser_specific_settings": {
    "gecko": {
      "id": "atonalfreerider@gmail.com",
      "strict_min_version": "134.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "scripting"
  ],
  "optional_permissions": ["trialML"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "comprehensive-test.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.news.ycombinator.com/*",
        "*://*.reddit.com/*",
        "*://*.tiktok.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "platform/*.js",
        "comprehensive-test.html",
        "comprehensive-test.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}